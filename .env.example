# 웹 접속 포트
FINDBID_PORT=3100
BACKEND_PORT=8100

# 실행 환경
APP_ENV=development
DEMO_MODE=true
INTERNAL_API_KEY=change-this-in-production

# PostgreSQL
POSTGRES_DB=findbid
POSTGRES_USER=findbid
POSTGRES_PASSWORD=findbid

# 외부 입찰공고 DB(비워두면 위 로컬 DB의 bid_notices 사용)
BID_DATABASE_URL=
BID_DATABASE_SCHEMA=public
BID_DATABASE_TABLE=bids

# 나라장터 공공데이터포털 일반 인증키
G2B_SERVICE_KEY=
COLLECT_INTERVAL_SECONDS=600

# 전체 프로필 선택 서비스
OPENSEARCH_PORT=9200
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY=findbid
S3_SECRET_KEY=findbid-storage
