FEEDBACK_SESSION_TTL_SECONDS=7200
FEEDBACK_ADJUSTMENT_LIMIT=10

# PostgreSQL(Local DB)
POSTGRES_DB=findbid
POSTGRES_USER=findbid
POSTGRES_PASSWORD=findbid

# 외부 입찰공고 DB(비워두면 위 로컬 DB의 bid_notices 사용)
BID_DATABASE_URL=postgresql+psycopg://bidding_user:tplan_secure_password_2024@222.106.216.52:15432/tplan_db
BID_DATABASE_SCHEMA=public
BID_DATABASE_TABLE=bids

# 나라장터 공공데이터포털 일반 인증키
G2B_SERVICE_KEY=
G2B_API_KEY=bnkyMYHjefi5XovYL2T5topUlfMQZmx82WZmk16thcKGqV7Yh2KGsaPR0dQvuqOdcKuT92M1uxeBoI8ej91x9w==
COLLECT_INTERVAL_SECONDS=600

# 수요기관 정보 동기화 (비워두면 위 G2B 키 재사용)
DEMAND_AGENCY_SYNC_ENABLED=true

# AI 시맨틱 검색
